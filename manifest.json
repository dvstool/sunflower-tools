{
  "manifest_version": 3,
  "name": "Sunflower Tools",
  "version": "1.0.0",
  "description": "A native split-screen side panel for Sunflower Land.",
  "permissions": ["sidePanel", "tabs", "scripting", "storage", "alarms", "notifications"],
  "host_permissions": ["https://sunflower-land.com/*", "https://sunflower-tools-license.sfl-ext-sang.workers.dev/*"],
  "action": {
    "default_title": "Open Sunflower Tools",
    "default_icon": "icons/sunflower-tools-icon.png"
  },
  "icons": {
    "16": "icons/sunflower-tools-icon.png",
    "32": "icons/sunflower-tools-icon.png",
    "48": "icons/sunflower-tools-icon.png",
    "128": "icons/sunflower-tools-icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  }
}
